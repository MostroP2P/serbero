# Secrets for Serbero. Copy to serbero.env, fill in, and chmod 600.
# Never commit the filled-in file.

# 64-character hex private key of Serbero's own Nostr identity.
SERBERO_PRIVATE_KEY=

# The operator's TypeSafe key; only needed once mediation is enabled.
TYPESAFE_API_KEY=

# Optional: more verbose logs, for example serbero=debug.
# SERBERO_LOG=serbero=info
