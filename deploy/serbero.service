# systemd unit for running the Serbero binary without Docker.
#
#   useradd --system --home-dir /var/lib/serbero --shell /usr/sbin/nologin serbero
#   install -m 755 serbero /usr/local/bin/serbero
#   install -d -m 755 /etc/serbero
#   install -m 644 config.toml /etc/serbero/config.toml
#   install -d -m 700 /etc/serbero/credentials
#   (umask 077; openssl rand -hex 32 > /etc/serbero/credentials/serbero_private_key)
#   install -m 644 deploy/serbero.service /etc/systemd/system/serbero.service
#   systemctl daemon-reload && systemctl enable --now serbero
#
# Needs systemd 247 or later for LoadCredential= and the %d specifier.
#
# Secrets are systemd credentials: root-only files that systemd hands to the
# service in a private directory ($CREDENTIALS_DIRECTORY, %d), so they never
# enter the environment. To keep them encrypted at rest, create them with
# `systemd-creds encrypt` and use LoadCredentialEncrypted= instead.
#
# The database lives in /var/lib/serbero (StateDirectory), which is also the
# working directory, so the default db_path "serbero.db" lands there. A fixed
# user, rather than DynamicUser, lets the operator inspect and back up the
# database as that user without creating files the service cannot write.

[Unit]
Description=Serbero, dispute assistant for Mostro
Documentation=https://github.com/MostroP2P/serbero
Wants=network-online.target
After=network-online.target

[Service]
Type=exec
ExecStart=/usr/local/bin/serbero
Environment=SERBERO_CONFIG=/etc/serbero/config.toml
LoadCredential=serbero_private_key:/etc/serbero/credentials/serbero_private_key
Environment=SERBERO_PRIVATE_KEY_FILE=%d/serbero_private_key
# With mediation enabled, also add the judge key:
# LoadCredential=typesafe_api_key:/etc/serbero/credentials/typesafe_api_key
# Environment=TYPESAFE_API_KEY_FILE=%d/typesafe_api_key
# Optional non-secret settings, such as SERBERO_LOG.
EnvironmentFile=-/etc/serbero/serbero.env
User=serbero
Group=serbero
StateDirectory=serbero
# The database holds dispute conversations: no other local user may read it.
StateDirectoryMode=0700
WorkingDirectory=/var/lib/serbero
Restart=on-failure
RestartSec=5s

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=yes
RemoveIPC=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
UMask=0077

[Install]
WantedBy=multi-user.target
